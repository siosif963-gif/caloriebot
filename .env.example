# Переменные для docker compose (скопируйте в .env рядом с docker-compose.yml)
BOT_TOKEN=123456789:AA...your_token
# Для проверки без Telegram: DEV_MODE=true и ПУСТОЙ BOT_TOKEN (вместе с токеном сервер не запустится).
# В продакшене только DEV_MODE=false.
DEV_MODE=false
FRONTEND_ORIGINS=http://localhost:5500
OFF_CONTACT_EMAIL=you@example.com
LOG_LEVEL=INFO
