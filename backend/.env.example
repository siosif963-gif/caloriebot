BOT_TOKEN=123456789:AA...your_token
DATABASE_URL=sqlite:////data/database.db
FRONTEND_ORIGINS=https://username.github.io
OFF_CONTACT_EMAIL=you@example.com
OFF_CACHE_TTL_DAYS=30
OFF_SEARCH_MAX_PER_MINUTE=8
INIT_DATA_MAX_AGE=86400
# DEV_MODE=true отключает проверку подписи Telegram: только для локальной проверки и только
# с ПУСТЫМ BOT_TOKEN. Вместе с токеном сервер откажется запускаться.
DEV_MODE=false
DEV_USER_ID=1
LOG_LEVEL=INFO
